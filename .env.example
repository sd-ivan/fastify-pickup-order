# The menu is defined in src/core/config.js; these settings control storage and pickup notices.
# The blank secrets are intentional; supply them in your private .env or deployment settings.
# The email guide is in docs/email-setup.md; development log mode works without provider credentials.

APP_URL=http://localhost:3000 # Address serving the order form, without a trailing path; checked on each submission.
HOST=127.0.0.1 # Bind the server here. The default accepts connections from this machine only.
PORT=3000 # Set the production listener port here; the dev server has its own configuration.
DB_PATH=.data/app.sqlite # Pickup orders, calculated totals, ready status, and queued notices; SQLite file relative to the app directory. Preserve it across deployments.
ADMIN_PASSWORD= # Set a random 16+ character password to mark pickup orders ready. Sign in as admin.
OWNER_EMAIL=owner@example.com # Not used for pickup instructions; this setting can be left empty.
REVIEWER_EMAIL=reviewer@example.com # Ignored by this workflow; pickup instructions do not use a configured reviewer.
MAIL_MODE=sandbox # For pickup instructions: sandbox for capture, production for real sending, log for local development.
MAIL_FROM=sender@example.com # Address sending pickup instructions; for production, choose one on your verified Mailtrap domain.
MAILTRAP_PRODUCTION_TOKEN= # Add your Mailtrap transactional token here to send pickup instructions in production.
MAILTRAP_SANDBOX_TOKEN= # API token with access to the Sandbox used for pickup order messages.
MAILTRAP_INBOX_ID= # Numeric Sandbox ID from its API integration settings; captured order email stays here.
MAILTRAP_TEMPLATE_UUID= # Optional production template UUID; use the matching template in email-templates/.
MAILTRAP_SANDBOX_TEMPLATE_UUID= # Optional template UUID accessible with the Sandbox token; blank uses built-in content.
